{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
     "types": ["node", "vitest/globals"],
    "strict": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "skipLibCheck": true,

    "outDir": "./dist",

    "rootDir": "./src"
  },

  "include": ["src"],


  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "node_modules"
  ]
}